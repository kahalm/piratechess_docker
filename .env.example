# MariaDB
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=piratechess
MYSQL_USER=piratechess
MYSQL_PASSWORD=change_me

# API
ASPNETCORE_ENVIRONMENT=Development
CONNECTION_STRING=Server=db;Port=3306;Database=piratechess;User=piratechess;Password=change_me;
JWT_SECRET=change_me_min_32_characters_long_secret_key
JWT_ISSUER=PirateChess
JWT_AUDIENCE=PirateChess
ENCRYPTION_KEY=change_me_exactly_32_chars_long!

# Service-to-service key for inter-stack calls (e.g. rookhub → /api/chessable/direct/*).
# Generate a random long string; must match rookhub's Chessable__ServiceKey.
SERVICE_API_KEY=change_me_long_random_string

# VPN (Gluetun + AirVPN)
VPN_PROVIDER=airvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=change_me
WIREGUARD_PRESHARED_KEY=change_me
WIREGUARD_ADDRESSES=change_me/32
VPN_SERVER_COUNTRIES=Netherlands
