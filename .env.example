# MariaDB
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=piratechess
MYSQL_USER=piratechess
MYSQL_PASSWORD=change_me

# API
ASPNETCORE_ENVIRONMENT=Development
CONNECTION_STRING=Server=db;Port=3306;Database=piratechess;User=piratechess;Password=change_me;
JWT_SECRET=change_me_min_32_characters_long_secret_key
JWT_ISSUER=PirateChess
JWT_AUDIENCE=PirateChess
ENCRYPTION_KEY=change_me_exactly_32_chars_long!

# Service-to-service key for inter-stack calls (e.g. rookhub → /api/chessable/direct/*).
# Generate a random long string; must match rookhub's Chessable__ServiceKey.
SERVICE_API_KEY=change_me_long_random_string

# Logging → Elasticsearch. Wenn leer, geht Logging nur in die Console.
# In dev typischerweise rookhubs ES (`http://rookhub-elasticsearch:9200`),
# erreichbar via Docker-Netz `chessable-bridge`.
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX_FORMAT=piratechess-logs-{0:yyyy.MM}

# VPN (Gluetun + AirVPN)
VPN_PROVIDER=airvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=change_me
WIREGUARD_PRESHARED_KEY=change_me
WIREGUARD_ADDRESSES=change_me/32
VPN_SERVER_COUNTRIES=Netherlands

# gluetun-Control-Server für die IP-Rotation (un-proxied, nur intern via
# FIREWALL_INPUT_PORTS=8000). Leer lassen deaktiviert die Rotation.
GLUETUN_CONTROL_URL=http://gluetun:8000
# Anzahl Requests bis zur nächsten IP-Rotation.
VPN_ROTATE_AFTER_REQUESTS=20
# Optionaler API-Key für den gluetun-Control-Server. Nur setzen, WENN
# gluetun-auth.toml auf auth="apikey" steht (== `apikey` dort). Leer lassen →
# piratechess schickt keinen X-API-Key-Header (auth="none" bleibt kompatibel).
# Umstellung erfordert einen koordinierten Neustart von gluetun + piratechess-api.
GLUETUN_APIKEY=
