# MariaDB
MYSQL_ROOT_PASSWORD=change_me_db_root_password
MYSQL_DATABASE=piratechess
MYSQL_USER=piratechess
# Muss mit Password= in CONNECTION_STRING übereinstimmen.
MYSQL_PASSWORD=change_me_db_password

# API
ASPNETCORE_ENVIRONMENT=Development
CONNECTION_STRING=Server=db;Port=3306;Database=piratechess;User=piratechess;Password=change_me_db_password;

# Geheimnisse der API: bewusst LEER, jedes einzeln erzeugen (z. B. openssl rand -base64 48), nie teilen.
# Werte, die mit change_me/your_ beginnen, gelten als nicht gesetzt: JWT_SECRET/ENCRYPTION_KEY brechen
# den Start ab, SERVICE_API_KEY schaltet /api/chessable/direct/* und /api/vpn/* ab (503).
# Pflicht, mindestens 32 Byte (leer → Start bricht ab).
JWT_SECRET=
JWT_ISSUER=PirateChess
JWT_AUDIENCE=PirateChess
# Verschlüsselt gespeicherte Chessable-Zugänge der Alt-Endpunkte; leer → diese Endpunkte schlagen fehl.
ENCRYPTION_KEY=

# Service-to-service key for inter-stack calls (e.g. rookhub → /api/chessable/direct/*).
# Generate a random long string; must match rookhub's Chessable__ServiceKey. Empty → 503 (fail-closed).
SERVICE_API_KEY=

# Logging → Elasticsearch. Wenn leer, geht Logging nur in die Console.
# In dev typischerweise rookhubs ES (`http://rookhub-elasticsearch:9200`),
# erreichbar via Docker-Netz `chessable-bridge`.
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX_FORMAT=piratechess-logs-{0:yyyy.MM}

# VPN (Gluetun + AirVPN)
VPN_PROVIDER=airvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=change_me_wireguard_private_key
WIREGUARD_PRESHARED_KEY=change_me_wireguard_preshared_key
WIREGUARD_ADDRESSES=change_me/32
VPN_SERVER_COUNTRIES=Netherlands
# Optional: auf bestimmte gluetun-/AirVPN-Server einschränken (sonst alle des Landes).
# ⚠️ FALLE: Liste MUSS komma-getrennt OHNE Leerzeichen sein ("Alpha,Beta,Gamma",
# NICHT "Alpha, Beta, Gamma"). gluetun trimmt KEINE Leerzeichen → jeder Name mit
# führendem Space matcht keinen Server ("... are not in choices"-WARN) und fällt raus.
# Ein Tunnel landet dann nur auf dem EINEN gültigen Namen = keine echte IP-Rotation
# (genau dieser Bug hat Prod 2026-06-29 auf 1 statt 74 Server limitiert). Leer = alle.
VPN_SERVER_NAMES=

# gluetun-Control-Server für die IP-Rotation (un-proxied, nur intern via
# FIREWALL_INPUT_PORTS=8000). Leer lassen deaktiviert die Rotation.
GLUETUN_CONTROL_URL=http://gluetun:8000
# Anzahl Requests bis zur nächsten IP-Rotation.
VPN_ROTATE_AFTER_REQUESTS=20
# Optionaler API-Key für den gluetun-Control-Server. Nur setzen, WENN
# gluetun-auth.toml auf auth="apikey" steht (== `apikey` dort). Leer lassen →
# piratechess schickt keinen X-API-Key-Header (auth="none" bleibt kompatibel).
# Umstellung erfordert einen koordinierten Neustart von gluetun + piratechess-api.
GLUETUN_APIKEY=
